# Public URL of the site, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.genevawellness.ph

# Where original Geneva photos and logo are loaded from. Defaults to the current live site.
# After copying them into public/legacy (same paths), set this to /legacy.
# NEXT_PUBLIC_LEGACY_ASSET_BASE=/legacy

# Booking popup delivery (server-side only, never exposed to the browser).
# /api/enquiry forwards each validated request to the leads API:
#   POST {LEADS_API_URL}/api/leads?type=call|booking&center={LEADS_CENTER}
# Leave LEADS_CENTER unset and the form tells visitors online sending is unavailable and offers WhatsApp/Messenger.
# LEADS_CENTER=
# LEADS_API_URL=https://miraculous-serenity-production-5d5a.up.railway.app

# Blog admin (/admin). Leave ADMIN_PASSWORD unset to switch the admin off.
# ADMIN_PASSWORD=choose-a-long-password
# Random string used to sign the login cookie, e.g. `openssl rand -hex 32`.
# ADMIN_SESSION_SECRET=
# Folder where blog posts (posts.json) and uploaded images are stored. Must be on a persistent disk.
# BLOG_DATA_DIR=./data
